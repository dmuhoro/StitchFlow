{
  "name": "stitchflow",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "check:docs": "node scripts/ci/check-doc-links.mjs",
    "verify:build": "node scripts/ci/verify-build.mjs",
    "verify:db": "bash scripts/verify-db.sh docker",
    "verify:db:host": "bash scripts/verify-db.sh host",
    "verify:hosted": "bash scripts/verify-hosted.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
