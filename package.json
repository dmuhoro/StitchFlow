{
  "name": "stitchflow",
  "private": true,
  "version": "1.4.0-rc.2",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --config vite.pilot.config.ts --port=3000 --host=0.0.0.0",
    "build": "vite build --config vite.pilot.config.ts",
    "postbuild": "node scripts/ci/verify-build.mjs",
    "preview": "vite preview --config vite.pilot.config.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:node": "node scripts/ci/check-node-version.mjs",
    "audit": "npm audit --audit-level=high",
    "check:docs": "node scripts/ci/check-doc-links.mjs",
    "verify:build": "node scripts/ci/verify-build.mjs",
    "verify:db": "bash scripts/verify-db.sh docker",
    "verify:db:host": "bash scripts/verify-db.sh host",
    "verify:hosted": "bash scripts/verify-hosted.sh",
    "seed:pilot": "node scripts/ops/seed-pilot.mjs",
    "seed:pilot-fitting": "node scripts/ops/seed-pilot-fitting.mjs",
    "verify:pilot": "node scripts/ops/verify-pilot.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:hermetic": "bash scripts/e2e/hermetic.sh",
    "verify:controls": "bash scripts/ci/negative-controls.sh",
    "rehearse:restore": "bash scripts/ops/backup-restore-rehearsal.sh",
    "rehearse:restore:hosted": "bash scripts/ops/run-with-ops-secrets.sh bash scripts/ops/backup-restore-rehearsal.sh",
    "ops:set-source-db": "bash scripts/ops/set-source-db.sh",
    "preflight": "bash scripts/ops/preflight.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
