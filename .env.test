# ---------------------------------------------------------------------------
# HERMETIC BROWSER-TEST ENVIRONMENT — tracked, local-only, no secrets
# ---------------------------------------------------------------------------
# Read only by `scripts/e2e/hermetic.sh`, which builds with `vite build --mode
# test`. A normal `npm run build` never loads this file.
#
# Every value here describes the disposable local Supabase stack. The URL is
# loopback and the stack is destroyed on teardown, so these identities cannot
# authenticate against the hosted pilot project or any other hosted project.
# No service-role key appears here, in any log, or in any evidence file.
# ---------------------------------------------------------------------------

VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=http://127.0.0.1:54521
# Overridden at run time by `.env.test.local`, which the runner fills with the
# stack's generated anon key. The placeholder is deliberately obvious: a build
# that skips the runner fails the artifact gate instead of shipping.
VITE_SUPABASE_PUBLISHABLE_KEY=hermetic_runner_must_inject_the_local_anon_key

# Local seed identities (`supabase/seed.sql` section 1). Passwords are generated
# per run by `scripts/e2e/seed-local.mjs` and passed in memory to Playwright.
STITCHFLOW_E2E_OWNER_EMAIL=danny@stitchflow.ke
STITCHFLOW_E2E_EMPLOYEE_EMAIL=amani@stitchflow.ke
STITCHFLOW_E2E_PATRON_EMAIL=zainab@diplomacy.org

# Local seed tenancies (`supabase/seed.sql` sections 2 and 6).
STITCHFLOW_SEED_ATELIER_A=11111111-1111-1111-1111-111111111111
STITCHFLOW_SEED_ATELIER_B=22222222-2222-2222-2222-222222222222
# Dedicated E2E fixture atelier; it exists only in the disposable loopback stack.
STITCHFLOW_E2E_ATELIER_ID=11111111-1111-1111-1111-111111111111
# Local seed identities (`supabase/seed.sql` section 1).
STITCHFLOW_SEED_OWNER_ID=a1111111-1111-1111-1111-111111111111
STITCHFLOW_SEED_EMPLOYEE_ID=a2222222-2222-2222-2222-222222222222
# Pending staff-inbox request that the owner confirms into a resource slot.
STITCHFLOW_SEED_PATRON_ID=a3333333-3333-3333-3333-333333333333
STITCHFLOW_SEED_PENDING_REQUEST_ID=a3000002-1111-1111-1111-111111111111

# Order codes read by the role fixtures default to the seed values (`ORD-892`
# in Nairobi, `LAG-401` in Lagos); they are asserted explicitly below so a seed
# change fails loudly instead of silently weakening the isolation assertion.
STITCHFLOW_E2E_OWN_ORDER=ORD-892
STITCHFLOW_E2E_FOREIGN_ORDER=LAG-401

# The booking date is intentionally absent: `e2e/support/fixtures.ts` computes
# it in the atelier's timezone for each run.
STITCHFLOW_E2E_BOOKING_RESOURCE_NAME=Bridal & Ceremonial Fitting Room
STITCHFLOW_E2E_BOOKING_TIME=09:00
STITCHFLOW_E2E_BOOKING_REQUEST_LABEL=Ruracio bridal basted fitting

# Invitation-acceptance journey. The invitee is NOT part of `supabase/seed.sql`:
# `accept_invitation` refuses to move an existing member, so the identity and the
# invitation row are created by `scripts/e2e/seed-local.mjs` on the loopback
# stack. The code is local-only and worthless outside this disposable stack.
STITCHFLOW_SEED_INVITEE_ID=a5555555-5555-4555-8555-555555555555
STITCHFLOW_E2E_EMAIL=mwikali@stitchflow.ke
STITCHFLOW_E2E_INVITE_CODE=hermetic-invite-0001
STITCHFLOW_E2E_EXPECTED_ROLE=employee
